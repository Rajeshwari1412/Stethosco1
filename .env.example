# Firebase Phone Authentication Environment Variables
# Get these keys from Firebase Console -> Project Settings -> General -> Your Apps (Web App)

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=stethosco-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stethosco-app
